{
  "name": "modelith-vscode",
  "displayName": "Modelith",
  "description": "Ontology-anchored, git-native data modeling for dbt \u2014 validate, generate, drift, and the Modelith canvas inside VS Code.",
  "version": "0.1.0",
  "publisher": "modelith",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbose/modelith.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/dbose/modelith",
  "bugs": {
    "url": "https://github.com/dbose/modelith/issues"
  },
  "keywords": [
    "dbt",
    "data modeling",
    "data engineering",
    "erd",
    "ontology",
    "data governance",
    "drift",
    "duckdb"
  ],
  "galleryBanner": {
    "color": "#0b0f16",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/mdl-project.yaml",
    "onChatParticipant:modelith.chat"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "modelith.mcp",
        "label": "Modelith"
      }
    ],
    "chatParticipants": [
      {
        "id": "modelith.chat",
        "name": "modelith",
        "fullName": "Modelith",
        "description": "Ask about entities, relationships, and ontology alignment in this model.",
        "commands": [
          {
            "name": "explain",
            "description": "Explain one entity: its attributes, ontology alignment, and relationships."
          },
          {
            "name": "list",
            "description": "List the model's entities."
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "modelith.validate",
        "title": "Modelith: Validate Model"
      },
      {
        "command": "modelith.generate",
        "title": "Modelith: Generate dbt Project"
      },
      {
        "command": "modelith.driftCheck",
        "title": "Modelith: Check Drift vs dbt Manifest"
      },
      {
        "command": "modelith.lintFix",
        "title": "Modelith: Lint Naming (--fix)"
      },
      {
        "command": "modelith.newEntity",
        "title": "Modelith: New Entity"
      },
      {
        "command": "modelith.openCanvas",
        "title": "Modelith: Open Canvas"
      },
      {
        "command": "modelith.import",
        "title": "Modelith: Import to Model"
      },
      {
        "command": "modelith.stopServer",
        "title": "Modelith: Stop Canvas Server"
      },
      {
        "command": "modelith.vendorFibo",
        "title": "Modelith: Vendor FIBO Ontology"
      },
      {
        "command": "modelith.emitSemantic",
        "title": "Modelith: Emit Semantic Layer (OSI/MetricFlow)"
      },
      {
        "command": "modelith.liftModel",
        "title": "Modelith: Lift to Logical Model"
      },
      {
        "command": "modelith.openPreview",
        "title": "Modelith: Open Model Preview to the Side"
      },
      {
        "command": "modelith.restartLsp",
        "title": "Modelith: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Modelith",
      "properties": {
        "modelith.mdlPath": {
          "type": "string",
          "default": "",
          "description": "Path to the mdl executable. Empty = auto-detect (.venv/bin/mdl \u2192 mdl on PATH \u2192 `uv run mdl`)."
        },
        "modelith.modelDir": {
          "type": "string",
          "default": "",
          "description": "Model repo directory (contains mdl-project.yaml). Empty = auto-discover in the workspace."
        },
        "modelith.dbtProjectDir": {
          "type": "string",
          "default": "",
          "description": "dbt project directory (contains dbt_project.yml). Used for generate output and drift manifest discovery. Empty = auto-discover."
        },
        "modelith.manifestPath": {
          "type": "string",
          "default": "",
          "description": "Path to manifest.json for drift. Empty = <dbtProjectDir>/target/manifest.json."
        },
        "modelith.canvas.display": {
          "type": "string",
          "enum": [
            "tab",
            "external"
          ],
          "default": "tab",
          "enumDescriptions": [
            "Embed the canvas in a VS Code editor tab (webview).",
            "Open the canvas in your browser via a forwarded port \u2014 recommended for devcontainers when you want a full window."
          ],
          "description": "Where to show the Modelith canvas."
        },
        "modelith.canvas.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the embedded canvas server. 0 = pick a free port."
        },
        "modelith.canvas.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Serve the canvas in read-only (viewer) mode."
        },
        "modelith.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `mdl validate` when a model YAML file is saved and surface MDL-* diagnostics in Problems."
        }
      }
    },
    "yamlValidation": [],
    "menus": {
      "explorer/context": [
        {
          "command": "modelith.liftModel",
          "when": "resourceExtname == .sql",
          "group": "modelith"
        },
        {
          "command": "modelith.import",
          "when": "resourceExtname == .sql || resourceExtname == .mmd",
          "group": "modelith"
        },
        {
          "command": "modelith.openPreview",
          "when": "resourceExtname == .sql || resourceExtname == .yaml",
          "group": "modelith"
        }
      ],
      "editor/context": [
        {
          "command": "modelith.liftModel",
          "when": "resourceExtname == .sql",
          "group": "modelith"
        },
        {
          "command": "modelith.import",
          "when": "resourceExtname == .sql || resourceExtname == .mmd",
          "group": "modelith"
        },
        {
          "command": "modelith.openPreview",
          "when": "resourceExtname == .sql || resourceExtname == .yaml",
          "group": "modelith"
        }
      ]
    }
  },
  "scripts": {
    "check-node": "node -e \"if(+process.versions.node.split('.')[0]<18){console.error('\\n  Node '+process.versions.node+' is too old for the build toolchain (vsce/esbuild need Node 18+).\\n  Use Node 20:  nvm use 20   (or: export NVM_DIR=$HOME/.nvm; . $NVM_DIR/nvm.sh; nvm use 20)\\n');process.exit(1)}\"",
    "vscode:prepublish": "npm run build -- --minify",
    "build": "npm run check-node && tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run check-node && npx @vscode/vsce package --no-dependencies",
    "publish": "npm run check-node && npx @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
