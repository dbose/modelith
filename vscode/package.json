{
  "name": "modelith-vscode",
  "displayName": "Modelith",
  "description": "Ontology-anchored, git-native data modeling for dbt — validate, generate, drift, and the Modelith canvas inside VS Code.",
  "version": "0.3.10",
  "publisher": "BosonResearch",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbose/modelith.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/dbose/modelith",
  "bugs": {
    "url": "https://github.com/dbose/modelith/issues"
  },
  "keywords": [
    "dbt",
    "data modeling",
    "data engineering",
    "erd",
    "ontology",
    "data governance",
    "drift",
    "duckdb"
  ],
  "galleryBanner": {
    "color": "#0b0f16",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/mdl-project.yaml",
    "onChatParticipant:modelith.chat"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "modelith.mcp",
        "label": "Modelith"
      }
    ],
    "chatParticipants": [
      {
        "id": "modelith.chat",
        "name": "modelith",
        "fullName": "Modelith",
        "description": "Ask about entities, relationships, and ontology alignment in this model.",
        "commands": [
          {
            "name": "explain",
            "description": "Explain one entity: its attributes, ontology alignment, and relationships."
          },
          {
            "name": "list",
            "description": "List the model's entities."
          },
          {
            "name": "drift",
            "description": "Explain drift vs the dbt manifest and recommend fixes. Optionally name a model."
          },
          {
            "name": "config",
            "description": "Explain how the reverse: config classifies your dbt models (roles, layers, exclusions)."
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modelith",
          "title": "Modelith",
          "icon": "$(git-compare)"
        }
      ]
    },
    "views": {
      "modelith": [
        {
          "id": "modelithConfig",
          "name": "Warehouse Config",
          "icon": "$(settings-gear)",
          "contextualTitle": "Modelith Warehouse Config"
        },
        {
          "id": "modelithReverse",
          "name": "Reverse Review",
          "icon": "$(git-pull-request-create)",
          "contextualTitle": "Modelith Reverse Review"
        },
        {
          "id": "modelithDrift",
          "name": "Drift",
          "icon": "$(git-compare)",
          "contextualTitle": "Modelith Drift"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modelithConfig",
        "when": "!modelith.configHasManifest",
        "contents": "See how Modelith classifies your dbt models, and teach it your warehouse's conventions.\n\nCompile your dbt project first so there's a manifest to read:\n[Run dbt docs generate](command:modelith.driftCheck)\n\nThen [Suggest a config](command:modelith.configSuggest) from your warehouse's own folders and prefixes."
      },
      {
        "view": "modelithConfig",
        "when": "modelith.configHasManifest",
        "contents": "No layers matched yet. Discover a starting config from your warehouse's folders and prefixes:\n[Suggest Config](command:modelith.configSuggest)\n\nOr inherit a team standard:\n[Import a Starter Pack](command:modelith.configImport)"
      }
    ],
    "commands": [
      {
        "command": "modelith.validate",
        "title": "Modelith: Validate Model"
      },
      {
        "command": "modelith.generate",
        "title": "Modelith: Generate dbt Project"
      },
      {
        "command": "modelith.reverse",
        "title": "Modelith: Reverse a Warehouse",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "modelith.reverseLive",
        "title": "Modelith: Reverse from a Live Database",
        "icon": "$(database)"
      },
      {
        "command": "modelith.compareReversed",
        "title": "Modelith: Compare Reversed Models",
        "icon": "$(git-compare)"
      },
      {
        "command": "modelith.reverseEngineer",
        "title": "Reverse Engineer to a Modelith Model",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "modelith.reverseRefresh",
        "title": "Modelith: Refresh Reverse Review",
        "icon": "$(refresh)"
      },
      {
        "command": "modelith.reverseAccept",
        "title": "Accept",
        "icon": "$(check)"
      },
      {
        "command": "modelith.reverseReject",
        "title": "Reject",
        "icon": "$(x)"
      },
      {
        "command": "modelith.configSuggest",
        "title": "Modelith: Suggest Reverse Config",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "modelith.configImport",
        "title": "Modelith: Import Reverse Config",
        "icon": "$(cloud-download)"
      },
      {
        "command": "modelith.configRefresh",
        "title": "Modelith: Refresh Warehouse Config",
        "icon": "$(refresh)"
      },
      {
        "command": "modelith.configFocusView",
        "title": "Modelith: Show Warehouse Config"
      },
      {
        "command": "modelith.configOpenProject",
        "title": "Modelith: Open mdl-project.yaml"
      },
      {
        "command": "modelith.driftCheck",
        "title": "Modelith: Check Drift vs dbt Manifest",
        "icon": "$(refresh)"
      },
      {
        "command": "modelith.driftReconcile",
        "title": "Modelith: Reconcile Safe Drift",
        "icon": "$(check)"
      },
      {
        "command": "modelith.driftExplain",
        "title": "Modelith: Explain Drift (@modelith)"
      },
      {
        "command": "modelith.driftFocusView",
        "title": "Modelith: Show Drift View"
      },
      {
        "command": "modelith.driftMapModel",
        "title": "Map to dbt model…",
        "icon": "$(link)"
      },
      {
        "command": "modelith.lintFix",
        "title": "Modelith: Lint Naming (--fix)"
      },
      {
        "command": "modelith.newEntity",
        "title": "Modelith: New Entity"
      },
      {
        "command": "modelith.openCanvas",
        "title": "Modelith: Open Canvas"
      },
      {
        "command": "modelith.import",
        "title": "Modelith: Import to Model"
      },
      {
        "command": "modelith.stopServer",
        "title": "Modelith: Stop Canvas Server"
      },
      {
        "command": "modelith.vendorFibo",
        "title": "Modelith: Vendor FIBO Ontology"
      },
      {
        "command": "modelith.emitSemantic",
        "title": "Modelith: Emit Semantic Layer (OSI/MetricFlow)"
      },
      {
        "command": "modelith.liftModel",
        "title": "Modelith: Lift to Logical Model"
      },
      {
        "command": "modelith.openPreview",
        "title": "Modelith: Open Model Preview to the Side"
      },
      {
        "command": "modelith.restartLsp",
        "title": "Modelith: Restart Language Server"
      },
      {
        "command": "modelith.installCli",
        "title": "Modelith: Install the CLI (mdl)"
      },
      {
        "command": "modelith.initDemo",
        "title": "Modelith: Try the Demo Model"
      },
      {
        "command": "modelith.openWalkthrough",
        "title": "Modelith: Open the Getting Started Walkthrough"
      }
    ],
    "configuration": {
      "title": "Modelith",
      "properties": {
        "modelith.mdlPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `mdl` executable (`mdl.exe` on Windows), or a command on PATH. Set this if auto-detect can't find your install. Empty = auto-detect: a workspace `.venv`, PATH, well-known install dirs, your selected Python interpreter's Scripts/bin dir, then `python -m mdl_cli`. Find your path with `where mdl` (Windows) or `which mdl`."
        },
        "modelith.modelDir": {
          "type": "string",
          "default": "",
          "description": "Model repo directory (contains mdl-project.yaml). Empty = auto-discover in the workspace."
        },
        "modelith.dbtProjectDir": {
          "type": "string",
          "default": "",
          "description": "dbt project directory (contains dbt_project.yml). Used for generate output and drift manifest discovery. Empty = auto-discover."
        },
        "modelith.manifestPath": {
          "type": "string",
          "default": "",
          "description": "Path to manifest.json for drift. Empty = <dbtProjectDir>/target/manifest.json."
        },
        "modelith.canvas.display": {
          "type": "string",
          "enum": [
            "tab",
            "external"
          ],
          "default": "tab",
          "enumDescriptions": [
            "Embed the canvas in a VS Code editor tab (webview).",
            "Open the canvas in your browser via a forwarded port — recommended for devcontainers when you want a full window."
          ],
          "description": "Where to show the Modelith canvas."
        },
        "modelith.canvas.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the embedded canvas server. 0 = pick a free port."
        },
        "modelith.canvas.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Serve the canvas in read-only (viewer) mode."
        },
        "modelith.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `mdl validate` when a model YAML file is saved and surface MDL-* diagnostics in Problems."
        }
      }
    },
    "yamlValidation": [],
    "walkthroughs": [
      {
        "id": "modelith.gettingStarted",
        "title": "Get Started with Modelith",
        "description": "Install the CLI, scaffold a demo model, and see the live ER canvas beside your dbt YAML.",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the Modelith CLI",
            "description": "The extension drives the `mdl` command-line tool. Install it once and everything else works with zero config.\n[Install the CLI](command:modelith.installCli)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "The Modelith ER canvas rendering a model beside its YAML"
            },
            "completionEvents": [
              "onCommand:modelith.installCli"
            ]
          },
          {
            "id": "tryDemo",
            "title": "Try the demo model",
            "description": "Scaffold a populated 7-entity example (written to ~/modelith-demo, never your repo) so the canvas has something real to show.\n[Create the demo model](command:modelith.initDemo)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "A populated entity-relationship model"
            },
            "completionEvents": [
              "onCommand:modelith.initDemo"
            ]
          },
          {
            "id": "openCanvas",
            "title": "Open the canvas",
            "description": "Open the entity-relationship canvas and watch it follow your YAML as you edit.\n[Open the Canvas](command:modelith.openCanvas)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "The Modelith canvas"
            },
            "completionEvents": [
              "onCommand:modelith.openCanvas"
            ]
          },
          {
            "id": "validate",
            "title": "Validate the model",
            "description": "Run validation and reach a green check — schema, refs, naming, and ontology all pass.\n[Validate the Model](command:modelith.validate)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "A validated model"
            },
            "completionEvents": [
              "onCommand:modelith.validate"
            ]
          },
          {
            "id": "generate",
            "title": "Generate the dbt project",
            "description": "Turn the model into dbt mart models — one governed model per entity, with columns, contracts, and relationship tests. Do this before checking drift: the marts are what drift compares against.\n[Generate the dbt Project](command:modelith.generate)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "Generated dbt models"
            },
            "completionEvents": [
              "onCommand:modelith.generate"
            ]
          },
          {
            "id": "checkDrift",
            "title": "Check drift vs the warehouse",
            "description": "Compare the model against the built dbt manifest. After generating (and a `dbt build`), drift is clean — each entity matches its mart, staging models are ignored.\n[Check Drift](command:modelith.driftCheck)",
            "media": {
              "image": "media/canvas.gif",
              "altText": "A clean drift report"
            },
            "completionEvents": [
              "onCommand:modelith.driftCheck"
            ]
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "modelith.reverseEngineer",
          "when": "explorerResourceIsFolder || resourceFilename == dbt_project.yml || resourceFilename == profiles.yml || resourceExtname == .sql",
          "group": "modelith@0"
        },
        {
          "command": "modelith.liftModel",
          "when": "resourceExtname == .sql",
          "group": "modelith"
        },
        {
          "command": "modelith.import",
          "when": "resourceExtname == .sql || resourceExtname == .mmd",
          "group": "modelith"
        },
        {
          "command": "modelith.openPreview",
          "when": "resourceExtname == .sql || resourceExtname == .yaml",
          "group": "modelith"
        }
      ],
      "editor/context": [
        {
          "command": "modelith.liftModel",
          "when": "resourceExtname == .sql",
          "group": "modelith"
        },
        {
          "command": "modelith.import",
          "when": "resourceExtname == .sql || resourceExtname == .mmd",
          "group": "modelith"
        },
        {
          "command": "modelith.openPreview",
          "when": "resourceExtname == .sql || resourceExtname == .yaml",
          "group": "modelith"
        }
      ],
      "view/title": [
        {
          "command": "modelith.configSuggest",
          "when": "view == modelithConfig",
          "group": "navigation@1"
        },
        {
          "command": "modelith.configImport",
          "when": "view == modelithConfig",
          "group": "navigation@2"
        },
        {
          "command": "modelith.configRefresh",
          "when": "view == modelithConfig",
          "group": "navigation@3"
        },
        {
          "command": "modelith.driftCheck",
          "when": "view == modelithDrift",
          "group": "navigation@1"
        },
        {
          "command": "modelith.driftReconcile",
          "when": "view == modelithDrift",
          "group": "navigation@2"
        },
        {
          "command": "modelith.reverse",
          "when": "view == modelithReverse",
          "group": "navigation@1"
        },
        {
          "command": "modelith.reverseLive",
          "when": "view == modelithReverse",
          "group": "navigation@2"
        },
        {
          "command": "modelith.compareReversed",
          "when": "view == modelithReverse",
          "group": "navigation@3"
        },
        {
          "command": "modelith.reverseRefresh",
          "when": "view == modelithReverse",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "modelith.reverseAccept",
          "when": "view == modelithReverse && viewItem == reverseDecision",
          "group": "inline@1"
        },
        {
          "command": "modelith.reverseReject",
          "when": "view == modelithReverse && viewItem == reverseDecision",
          "group": "inline@2"
        },
        {
          "command": "modelith.driftMapModel",
          "when": "view == modelithDrift && viewItem == driftItem:modelRemoved",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "check-node": "node -e \"if(+process.versions.node.split('.')[0]<18){console.error('\\n  Node '+process.versions.node+' is too old for the build toolchain (vsce/esbuild need Node 18+).\\n  Use Node 20:  nvm use 20   (or: export NVM_DIR=$HOME/.nvm; . $NVM_DIR/nvm.sh; nvm use 20)\\n');process.exit(1)}\"",
    "vscode:prepublish": "npm run build -- --minify",
    "build": "npm run check-node && tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "regression": "bash scripts/regression.sh",
    "package": "npm run check-node && npx @vscode/vsce package --no-dependencies",
    "publish": "npm run check-node && npx @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
